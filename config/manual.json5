{
  // 手写补充规则，格式与 dev-sidecar 的 server 段一致。
  // 这里的条目优先级最高，会直接覆盖自动生成的结果。
  // 最近一次维护：2026-10-17（ech 名单 / anyrouter 解析线路 / agentrouter SNI 改写）
  // 例：
  // server: {
  //   intercepts: {
  //     "example.com": { ".*": { sni: "baidu.com" } },
  //   },
  //   preSetIpList: {
  //     "example.com": { "1.2.3.4": true },
  //   },
  // },

  server: {
    dns: {
      ech: {
        // 追加到官方 ech.domains（并集，不覆盖官方条目）
        // idcflare.com 的 HTTPS 记录自带 ech 参数
        // nodeseek.com 自身未发布 ECHConfig，靠 publicName（cloudflare-ech.com）的共享配置兜底
        domains: [
          "*idcflare.com",
          "*nodeseek.com",
        ],
      },
      mapping: {
        // anyrouter.top 是双线路 CNAME 分流：国内解析落到 bestcf（Cloudflare 优选），
        // 该边缘没有它的证书（真实 SNI 报 handshake_failure），伪 SNI 又被 403。
        // 改用境外 DoH 解析，拿到腾讯云 EdgeOne 那条线路，真实 SNI 直连即可。
        "*anyrouter.top": "cf-DoH",
      },
    },

    intercepts: {
      // agentrouter.org（阿里云国际站 ALB，新加坡）：真实 SNI 被 RST，伪 SNI 能拿到真站内容
      "*agentrouter.org": { ".*": { sni: "baidu.com" } },
    },

    preSetIpList: {
      // 只钉 8.214.161.192：同组的 8.214.160.125 连伪 SNI 都不稳定
      "*agentrouter.org": { "8.214.161.192": true },
    },
  },
}
